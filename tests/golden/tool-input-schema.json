{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "tone": {
      "type": "string",
      "enum": [
        "neutral",
        "enthusiastic",
        "urgent",
        "editorial"
      ]
    },
    "headline": {
      "type": "string"
    },
    "subheadline": {
      "type": [
        "string",
        "null"
      ]
    },
    "blocks": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "hero"
              },
              "headline": {
                "type": "string"
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sku": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ctaLabel": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "headline",
              "body",
              "sku",
              "ctaLabel"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "grid"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "columns": {
                "anyOf": [
                  {
                    "type": "number",
                    "const": 2
                  },
                  {
                    "type": "number",
                    "const": 3
                  },
                  {
                    "type": "number",
                    "const": 4
                  }
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "similar_to_current",
                        "most_viewed",
                        "complements_cart",
                        "complements_purchase",
                        "liked_category",
                        "popular"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "badge": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "emphasis": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "featured"
                      ]
                    }
                  },
                  "required": [
                    "sku",
                    "basis",
                    "reason",
                    "badge",
                    "emphasis"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "title",
              "columns",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "carousel"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "items": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "sku": {
                      "type": "string"
                    },
                    "basis": {
                      "type": "string",
                      "enum": [
                        "similar_to_current",
                        "most_viewed",
                        "complements_cart",
                        "complements_purchase",
                        "liked_category",
                        "popular"
                      ]
                    },
                    "reason": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "badge": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "emphasis": {
                      "type": "string",
                      "enum": [
                        "normal",
                        "featured"
                      ]
                    }
                  },
                  "required": [
                    "sku",
                    "basis",
                    "reason",
                    "badge",
                    "emphasis"
                  ]
                }
              }
            },
            "required": [
              "kind",
              "title",
              "items"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "banner"
              },
              "tone": {
                "type": "string",
                "enum": [
                  "info",
                  "promo",
                  "urgency",
                  "restock"
                ]
              },
              "text": {
                "type": "string"
              },
              "ctaLabel": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "tone",
              "text",
              "ctaLabel"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "copy"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "title",
              "body"
            ]
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "bundle"
              },
              "title": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "body": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "ctaLabel": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "bundleId": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "kind",
              "title",
              "body",
              "ctaLabel",
              "bundleId"
            ]
          }
        ]
      }
    },
    "rationale": {
      "type": "string"
    }
  },
  "required": [
    "tone",
    "headline",
    "subheadline",
    "blocks",
    "rationale"
  ]
}
