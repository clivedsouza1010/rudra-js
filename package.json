{
  "name": "rudra-js",
  "version": "0.1.0",
  "private": true,
  "description": "A framework of server side components built dynamically and rendered in real time",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clivedsouza1010/rudra-js.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p examples/shop/tsconfig.json",
    "lint": "oxlint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "oxlint": "^1.80.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
