{
  "name": "rudra-js",
  "version": "0.1.0",
  "private": true,
  "description": "A framework of server side components built dynamically and rendered in real time",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clivedsouza1010/rudra-js.git"
  },
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "check": "npm run build && npm run typecheck && npm run lint && npm run format:check && npm test && npm run verify:consumer",
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.typecheck.json && tsc -p tsconfig.tools.json && tsc -p examples/shop/tsconfig.json",
    "lint": "oxlint --deny-warnings",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "bench": "tsx bench/run.ts",
    "verify:consumer": "node scripts/verify-consumer.mjs",
    "verify:crawlable": "tsx crawl/verify.ts",
    "matrix:crawler": "tsx crawl/run-matrix.ts",
    "test:watch": "vitest",
    "clean": "rm -rf packages/*/dist packages/*/*.tsbuildinfo"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
