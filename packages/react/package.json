{
  "name": "@rudra/react",
  "version": "0.1.0",
  "description": "Renders a rudra component specification as React Server Components",
  "license": "MIT",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
