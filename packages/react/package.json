    "react": "^19.0.0"
  },
  "devDependencies": {
    "@rudra/core": "0.1.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
