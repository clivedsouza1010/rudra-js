{
  "name": "@rudra-js/react",
  "version": "0.7.1",
  "description": "Renders a rudra component specification with React 18 or 19, on the server or in the browser",
  "keywords": [
    "react",
    "react-server-components",
    "rsc",
    "llm",
    "recommendations",
    "ecommerce",
    "ssr"
  ],
  "license": "MIT",
  "author": "Clive Dsouza",
  "homepage": "https://rudrajs.com",
  "bugs": {
    "url": "https://github.com/clivedsouza1010/rudra-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clivedsouza1010/rudra-js.git",
    "directory": "packages/react"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@rudra-js/core": "^0.7.1",
    "react": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@rudra-js/core": "0.7.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
