{
  "name": "@rudra-js/core",
  "version": "0.8.0",
  "description": "Core of rudra-js, a TypeScript library for LLM-designed product recommendations: turns one page view into a recommendation spec checked against your catalog",
  "keywords": [
    "rudra-js",
    "product-recommendations",
    "llm",
    "recommendations",
    "ecommerce",
    "personalization",
    "ssr",
    "zod",
    "typescript"
  ],
  "license": "MIT",
  "author": "Clive Dsouza",
  "homepage": "https://rudrajs.com",
  "bugs": {
    "url": "https://github.com/clivedsouza1010/rudra-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clivedsouza1010/rudra-js.git",
    "directory": "packages/core"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "default": "./dist/schemas.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "src/**/*.tsx",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@rudra-js/attested": "^0.8.0"
  },
  "devDependencies": {
    "@rudra-js/attested": "0.8.0",
    "@types/node": "^26.4.1"
  }
}
