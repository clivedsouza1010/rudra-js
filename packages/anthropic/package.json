{
  "name": "@rudra-js/anthropic",
  "version": "0.9.1",
  "description": "Use Anthropic's models with rudra-js. It calls the API with fetch, so there's no Anthropic SDK to install.",
  "keywords": [
    "rudra-js",
    "product-recommendations",
    "anthropic",
    "claude",
    "llm",
    "ecommerce",
    "typescript"
  ],
  "license": "MIT",
  "author": "Clive Dsouza",
  "homepage": "https://rudrajs.com",
  "bugs": {
    "url": "https://github.com/clivedsouza1010/rudra-js/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clivedsouza1010/rudra-js.git",
    "directory": "packages/anthropic"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/**/*.ts",
    "!src/**/*.test.ts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "peerDependencies": {
    "@rudra-js/core": "^0.9.1"
  },
  "devDependencies": {
    "@rudra-js/core": "0.9.1",
    "@types/node": "^26.4.1"
  }
}
