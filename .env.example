# --- LLM provider selection -------------------------------------------------
# One of: anthropic | openai | none
# "none" skips the LLM entirely and always renders the deterministic fallback
# spec. Useful for the CSR/SSR benchmark baseline and for local development.
RUDRA_PROVIDER=anthropic

# --- Anthropic (@rudra/provider-anthropic) ----------------------------------
ANTHROPIC_API_KEY=sk-ant-...
# Optional override. Defaults to claude-opus-5.
RUDRA_ANTHROPIC_MODEL=claude-opus-5

# --- OpenAI (@rudra/provider-openai) ----------------------------------------
OPENAI_API_KEY=sk-...
# Must be a model that supports strict JSON-schema structured outputs.
RUDRA_OPENAI_MODEL=gpt-4.1

# --- Generation tuning ------------------------------------------------------
# Hard wall-clock budget for the LLM call. When it elapses the generator
# resolves with the deterministic fallback spec so SSR is never blocked.
RUDRA_TIMEOUT_MS=1200
# Generated-spec cache TTL.
RUDRA_CACHE_TTL_MS=60000
